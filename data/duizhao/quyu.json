{
  "_meta": {
    "title": "Geographic region anchors for approximate place naming",
    "scope": "Coarse region names for any map point that does not fall on a known observation site. A point takes the name of its nearest anchor, so a large landmass or ocean may carry several anchors sharing one name. These are not political boundaries; detail comes from adding anchors, not from drawing borders.",
    "fields": "lat/lon = anchor position in decimal degrees. name = region name in zh-Hans, zh-Hant, en, fr, es, it, ja. since = astronomical year from which the main name applies (optional). before = the name used before that year, same shape as name (optional).",
    "provenance": "Hand-compiled. Anchors that carry a state name (Japan, France, Russia, Canada, Brazil, Australia, New Zealand) have a since year and a neutral earlier name, so a point predating the state resolves to a geographic name instead of an anachronistic country name.",
    "count": {
      "anchors": 124
    },
    "license": "CC-BY-SA-4.0",
    "updated": "2026-07-27",
    "caveats": [
      "Naming is approximate by design, and no boundary is implied.",
      "since is inclusive and given in astronomical years: a year below since resolves to before.name, any other year to the main name.",
      "Long-lived geographic and cultural names such as Persia, Egypt, India, Greece, Italy and Iberia carry no timeline.",
      "Where a timeline is present, the cutoff year is a conventional round figure rather than a documented date."
    ]
  },
